FROM python:3.12-slim

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates unzip \
    && rm -rf /var/lib/apt/lists/*

# Python packages the RLM-generated code commonly needs
RUN pip install --no-cache-dir pyyaml

# Install vulnx — detect arch for multi-platform support
RUN ARCH=$(dpkg --print-architecture) \
    && case "$ARCH" in \
        amd64) VULNX_ARCH="linux_amd64" ;; \
        arm64) VULNX_ARCH="linux_arm64" ;; \
        *) echo "Unsupported arch: $ARCH" && exit 1 ;; \
    esac \
    && VULNX_VERSION=$(curl -fsSL https://api.github.com/repos/projectdiscovery/vulnx/releases/latest \
        | grep '"tag_name"' | sed 's/.*"tag_name": *"\([^"]*\)".*/\1/') \
    && curl -fsSL \
        "https://github.com/projectdiscovery/vulnx/releases/download/${VULNX_VERSION}/vulnx_${VULNX_VERSION#v}_${VULNX_ARCH}.zip" \
        -o /tmp/vulnx.zip \
    && unzip /tmp/vulnx.zip vulnx -d /usr/local/bin/ \
    && chmod +x /usr/local/bin/vulnx \
    && rm /tmp/vulnx.zip

ARG PDCP_API_KEY=""
RUN if [ -n "$PDCP_API_KEY" ]; then vulnx auth --api-key "$PDCP_API_KEY"; fi
ENV PDCP_API_KEY=${PDCP_API_KEY}

WORKDIR /sandbox

# The REPL script is mounted at runtime, not baked in
CMD ["python3", "-u", "/sandbox/_repl.py"]
